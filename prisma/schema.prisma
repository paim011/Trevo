generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String    @id @default(cuid())
  name              String?
  email             String    @unique
  emailVerified     DateTime?
  image             String?
  password          String?
  birthDate         DateTime?
  // Quando o usuário aceitou a política de privacidade (/privacidade) no
  // cadastro. Contas criadas antes deste campo ficam com null.
  privacyAcceptedAt DateTime?
  role              Role      @default(FAMILY)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  familyProfile    FamilyProfile?
  caregiverProfile CaregiverProfile?

  reviewsWritten  Review[] @relation("ReviewAuthor")
  reviewsReceived Review[] @relation("ReviewTarget")

  hiresAsFamily    Hire[] @relation("HireFamily")
  hiresAsCaregiver Hire[] @relation("HireCaregiver")
}

enum Role {
  FAMILY
  CAREGIVER
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model FamilyProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  phone               String?
  city                String?
  state               String?
  address             String?
  bio                 String?
  // Consentimento específico e destacado (LGPD, art. 11, I) para as
  // informações de saúde que a descrição livre pode conter. Sem ele a
  // descrição não é gravada; revogar o consentimento apaga a descrição.
  healthDataConsentAt DateTime?
  hourlyBudget        Decimal?   @db.Decimal(10, 2)
  latitude            Float?
  longitude           Float?
  neededCareTypes     CareType[]

  // Indica se esta família aparece quando um cuidador navega/busca famílias
  // ou é casada via Gale-Shapley (ver lib/matching.ts findCandidateFamilies).
  // Nunca afeta a própria busca desta família por cuidadores -- a
  // visibilidade é direcional, por lado.
  visibleToCaregivers Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CaregiverProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  phone           String?
  city            String?
  state           String?
  bio             String?
  hourlyRate      Decimal?   @db.Decimal(10, 2)
  experienceYears Int?
  careTypes       CareType[]
  verified        Boolean    @default(false)
  latitude        Float?
  longitude       Float?

  // Indica se este cuidador aparece quando uma família navega/busca
  // cuidadores ou é casado via Gale-Shapley (ver lib/matching.ts
  // findCandidateCaregivers). Nunca afeta a própria busca deste cuidador por
  // famílias -- a visibilidade é direcional, por lado.
  visibleToFamilies  Boolean               @default(true)
  // Puramente informativo -- exibido como um selo onde quer que um cuidador
  // seja mostrado a uma família, nunca usado para filtrar ou reordenar
  // resultados de busca/matching (ver lib/matching.ts).
  availabilityStatus CaregiverAvailability @default(AVAILABLE)

  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CareType {
  ELDERLY
  CHILD
  SPECIAL_NEEDS
}

enum CaregiverAvailability {
  AVAILABLE
  BUSY
  UNAVAILABLE
}

model Document {
  id          String           @id @default(cuid())
  caregiverId String
  caregiver   CaregiverProfile @relation(fields: [caregiverId], references: [id], onDelete: Cascade)

  type    DocumentType
  fileUrl String
  status  VerificationStatus @default(PENDING)

  uploadedAt DateTime  @default(now())
  reviewedAt DateTime?
}

enum DocumentType {
  ID_DOCUMENT
  BACKGROUND_CHECK
  CERTIFICATE
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Hire {
  id String @id @default(cuid())

  familyId String
  family   User   @relation("HireFamily", fields: [familyId], references: [id])

  caregiverId String
  caregiver   User   @relation("HireCaregiver", fields: [caregiverId], references: [id])

  status      HireStatus    @default(PENDING)
  // Quem entrou em contato primeiro -- determina qual lado está "propondo"
  // (pode desistir de um pedido ainda PENDING) vs. "respondendo" (pode
  // aceitar/recusar). Ver lib/hire-transitions.ts. Padrão FAMILY para que
  // toda linha de Hire criada antes deste campo existir (só famílias
  // podiam iniciar até então) mantenha seu significado histórico correto
  // sem uma migração de dados.
  initiatedBy HireInitiator @default(FAMILY)
  message     String?
  startDate   DateTime?
  endDate     DateTime?

  // Qual necessidade específica motivou este Hire, escolhida a partir da
  // interseção real entre os tipos de cuidado dos dois perfis no momento da
  // criação (ver POST /api/hires). Anulável, não retroativo -- Hires
  // criados antes deste campo existir simplesmente mostram "Tipo não
  // especificado" (ver /dashboard/hires/[id]), mesmo padrão não-retroativo
  // já usado para acceptedAt/completedAt acima.
  careType CareType?

  // Timestamps reais das duas transições de máquina de estados que importam
  // para exibição (PENDING -> ACCEPTED, ACCEPTED -> COMPLETED), definidos
  // por PATCH /api/hires/[id] -- nunca reconstruíveis retroativamente, então
  // linhas criadas antes deste campo existir simplesmente ficam com null
  // (ver /dashboard/hires/[id], que mostra "Duração não disponível" em vez
  // de tentar adivinhar).
  acceptedAt  DateTime?
  completedAt DateTime?

  // Definido como "<familyId>:<caregiverId>" enquanto o status é PENDING ou
  // ACCEPTED, e voltado para null em qualquer transição terminal (REJECTED,
  // COMPLETED, CANCELLED). Índices únicos do Postgres tratam múltiplos NULL
  // como não-conflitantes, então isso garante "no máximo um Hire ativo por
  // par família-cuidador" como uma constraint real de banco (não só uma
  // checagem no nível da aplicação), permitindo ainda que um novo Hire seja
  // criado depois que o anterior chegar a um estado terminal.
  activeHireKey String? @unique

  review Review?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum HireStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
  CANCELLED
}

enum HireInitiator {
  FAMILY
  CAREGIVER
}

model Review {
  id String @id @default(cuid())

  hireId String @unique
  hire   Hire   @relation(fields: [hireId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("ReviewAuthor", fields: [authorId], references: [id])

  targetId String
  target   User   @relation("ReviewTarget", fields: [targetId], references: [id])

  rating  Int
  comment String?

  createdAt DateTime @default(now())
}
