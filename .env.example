# PostgreSQL connection string used by Prisma (via Supabase's connection pooler).
# See: https://pris.ly/d/connection-strings
DATABASE_URL="postgresql://user:password@localhost:5432/cuidadores?schema=public"

# Direct connection, used only by Prisma CLI for migrations.
DIRECT_URL="postgresql://user:password@localhost:5432/cuidadores?schema=public"

# NextAuth (Auth.js)
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-generated-secret"
NEXTAUTH_URL="http://localhost:3000"

# Chave mestra da criptografia em duas camadas (Cifra Trevo + AES-256-GCM)
# dos dados sensíveis -- ver lib/field-encryption.ts. 32 bytes em base64.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Se for perdida ou trocada, os dados já cifrados não podem mais ser lidos.
FIELD_ENCRYPTION_KEY="replace-with-32-random-bytes-in-base64"

# Supabase Storage (document uploads) — service_role key, backend only, never
# expose to the client. See lib/supabase-admin.ts.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-your-service-role-key"
